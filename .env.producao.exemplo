# MODELO do arquivo .env.producao (que NUNCA é versionado). Copie para .env.producao no servidor e
# preencha TODOS os valores. Gere senhas longas e aleatórias, por exemplo: openssl rand -base64 36
# Os valores abaixo são marcadores, não servem para uso.

NODE_ENV=production

# Endereços. Trocar de domínio é só mudar estas linhas e reimplantar.
HOSTNAME_APP=dominio.nucleodedados.com
HOSTNAME_PUBLICO=acompanhe.dominio.nucleodedados.com

# Superusuário do Postgres (usado só pelo contêiner do banco e pelos scripts de backup/restauração).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE-ESTA-SENHA

# Papéis da aplicação. O host é "postgres" (o serviço do compose). Cada papel tem a sua senha.
DATABASE_URL_API=postgresql://app_api:TROQUE-SENHA-API@postgres:5432/gabinete
DATABASE_URL_WORKER=postgresql://app_worker:TROQUE-SENHA-WORKER@postgres:5432/gabinete
DATABASE_URL_PUBLICO=postgresql://app_publico:TROQUE-SENHA-PUBLICO@postgres:5432/gabinete

# Segredo da sessão (ao menos 32 caracteres). Trocar derruba todas as sessões.
SESSAO_SEGREDO=TROQUE-POR-UM-SEGREDO-LONGO-E-ALEATORIO-COM-MAIS-DE-32-CARACTERES

# Armazenamento de arquivos: Cloudflare R2 (a conta do R2 precisa ter titularidade definida, PV-E).
S3_ENDPOINT=https://SEU-ID-DA-CONTA.r2.cloudflarestorage.com
S3_BUCKET=gabinete
S3_ACCESS_KEY=
S3_SECRET_KEY=

# E-mail ao cidadão (fase 3). O worker envia pelo provedor transacional Resend.
# O remetente precisa estar num domínio com SPF, DKIM e DMARC configurados ANTES do primeiro envio real
# (veja docs/especificacao/10-notificacoes-e-consentimento.md).
EMAIL_PROVEDOR=resend
EMAIL_API_KEY=
EMAIL_REMETENTE=avisos@dominio.nucleodedados.com
# Limite de envios por hora (protege a reputação do domínio).
LIMITE_EMAILS_POR_HORA=30

# NÃO coloque aqui DATABASE_URL_ADMIN nem DATABASE_URL_MIGRACAO: a API se recusa a subir com elas.
# Elas ficam em .env.administrativo (veja docs/operacao/implantacao.md).
