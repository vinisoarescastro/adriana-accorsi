{
  "name": "@gabinete/banco",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Único lugar que conhece SQL e o esquema: migrações, Drizzle, papéis, invariantes e comandos",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./senha": "./src/senha.ts",
    "./teste": "./src/teste/auxiliares.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "papeis": "tsx --env-file-if-exists=../../.env src/comandos/papeis.ts",
    "migrar": "tsx --env-file-if-exists=../../.env src/comandos/migrar.ts",
    "verificar": "tsx --env-file-if-exists=../../.env src/comandos/verificar.ts",
    "criar-administrador": "tsx --env-file-if-exists=../../.env src/comandos/criar-administrador.ts",
    "semear": "tsx --env-file-if-exists=../../.env src/comandos/semear.ts"
  },
  "dependencies": {
    "@gabinete/compartilhado": "*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1"
  }
}
