# MODELO do arquivo .env.administrativo (NUNCA versionado; permissão 600). Só o script de
# implantação o lê, para criar os papéis e aplicar as migrações. Nenhum serviço o recebe.
# As senhas dos papéis aqui devem ser IGUAIS às de .env.producao.

DATABASE_URL_ADMIN=postgresql://postgres:TROQUE-ESTA-SENHA@postgres:5432/gabinete
DATABASE_URL_MIGRACAO=postgresql://app_migracao:TROQUE-SENHA-MIGRACAO@postgres:5432/gabinete
DATABASE_URL_API=postgresql://app_api:TROQUE-SENHA-API@postgres:5432/gabinete
DATABASE_URL_WORKER=postgresql://app_worker:TROQUE-SENHA-WORKER@postgres:5432/gabinete
DATABASE_URL_PUBLICO=postgresql://app_publico:TROQUE-SENHA-PUBLICO@postgres:5432/gabinete
