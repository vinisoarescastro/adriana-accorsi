# Rascunho das variáveis previstas. Será validado por Zod na subida (fase 1).
# Copie para .env e preencha. Nunca versione o .env.

# Ambiente: development, test ou production
NODE_ENV=development

# Endereços (trocar de domínio deve ser só mudar estes valores).
# Só o nome do host: sem https:// e sem porta.
HOSTNAME_APP=dominio.nucleodedados.com
HOSTNAME_PUBLICO=acompanhe.dominio.nucleodedados.com

# Porta do Postgres local no seu computador (a 5432 costuma estar ocupada no Windows).
POSTGRES_PORTA=5432

# Banco. Cada processo usa o seu papel, com a sua senha (mínimo de 8 caracteres).
# Os nomes de usuário são fixos: app_migracao, app_api, app_worker, app_publico.
# Exemplo local: postgresql://app_api:SENHA@127.0.0.1:5432/gabinete
DATABASE_URL_MIGRACAO=
DATABASE_URL_API=
DATABASE_URL_WORKER=
DATABASE_URL_PUBLICO=

# Conexão ADMINISTRATIVA. Só o comando `banco:papeis` a usa; nunca defina nos processos da aplicação.
# Local (compose.yaml): postgresql://dev:dev@127.0.0.1:5432/gabinete
DATABASE_URL_ADMIN=

# Antivírus (ClamAV). Opcional em desenvolvimento (compose.yaml tem o serviço); obrigatório em produção.
CLAMAV_HOST=
CLAMAV_PORTA=3310

# Armazenamento de arquivos (S3 compatível: Cloudflare R2 em produção; S3Mock local, ver compose.yaml: endpoint http://127.0.0.1:9090, bucket gabinete, qualquer chave)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# E-mail ao cidadão (worker). Em desenvolvimento use o Mailpit do compose (SMTP, sem enviar nada para fora):
#   EMAIL_PROVEDOR=smtp  SMTP_HOST=127.0.0.1  SMTP_PORTA=1025  EMAIL_REMETENTE=avisos@exemplo.test
# Em produção: EMAIL_PROVEDOR=resend e EMAIL_API_KEY.
EMAIL_PROVEDOR=smtp
EMAIL_API_KEY=
EMAIL_REMETENTE=avisos@exemplo.test
SMTP_HOST=127.0.0.1
SMTP_PORTA=1025
LIMITE_EMAILS_POR_HORA=30
INTERVALO_DO_WORKER_SEGUNDOS=15

# App público (área do cidadão)
HOST_PUBLICO=127.0.0.1
PORTA_PUBLICO=3100

# Sessão
SESSAO_SEGREDO=
